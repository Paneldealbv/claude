# Kopieer naar .env.local en vul in. .env.local wordt nooit gecommit.
# Online (Vercel) zet je dezelfde namen onder Settings → Environment Variables.

# Supabase-project (Project Settings → API Keys). Beide zijn bedoeld voor de
# browser; de beveiliging zit in de Row Level Security van de database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adres van de app, voor links in e-mails (bevestigen, wachtwoord, uitnodiging).
# Lokaal: http://localhost:3000 — online: https://<jouw-domein>
NEXT_PUBLIC_SITE_URL=

# AI-herkenning van facturen en bonnen (optioneel). Geheim: alleen op de server,
# nooit met NEXT_PUBLIC_ ervoor. Zonder sleutel voer je documenten zelf in.
ANTHROPIC_API_KEY=

# NIET invullen in .env.local of Vercel. Alleen nodig voor scripts/supabase-beheer.mjs
# en dan als tijdelijke omgevingsvariabele:
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
